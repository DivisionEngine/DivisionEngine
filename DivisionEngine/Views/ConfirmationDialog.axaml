<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:DivisionEngine.Editor"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="100"
        x:Class="DivisionEngine.Editor.ConfirmationDialog"
        x:DataType="local:ConfirmationDialog"
        Title="Confirm"
        WindowStartupLocation="CenterOwner"
        Background="#111">
  <Border x:Name="MainBorder" Background="#111"/>
</Window>
