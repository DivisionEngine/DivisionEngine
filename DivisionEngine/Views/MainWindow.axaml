<Window xmlns="https://github.com/avaloniaui"
        xmlns:icons="using:Material.Icons.Avalonia"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DivisionEngine.Editor.ViewModels"
        xmlns:local="using:DivisionEngine.Editor"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="DivisionEngine.Editor.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/DivisionEngineLogoRAS.ico"
        Title="Division Engine" Background="#111" Foreground="#ccc">
  <!--Editor Window Templates-->
  <!--DO NOT FORGET TO PUT CUSTOM WINDOWS HERE!-->
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type local:ViewModels.WorldWindowViewModel}">
      <local:WorldWindow/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ViewModels.AssetsWindowViewModel}">
      <local:AssetsWindow/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ViewModels.ConsoleWindowViewModel}">
      <local:ConsoleWindow/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ViewModels.EnvironmentWindowViewModel}">
      <local:EnvironmentWindow/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ViewModels.PropertiesWindowViewModel}">
      <local:PropertiesWindow/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ViewModels.SettingsWindowViewModel}">
      <local:SettingsWindow/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ViewModels.DeveloperWindowViewModel}">
      <local:DeveloperWindow/>
    </DataTemplate>
  </Window.DataTemplates>

  <!--Main Window-->
  <DockPanel Background="#333">
    <!--Main Menu-->
    <StackPanel DockPanel.Dock="Top" Background="#444" Orientation="Horizontal">
      <TextBlock Text="Division Engine" FontWeight="Bold" FontSize="16" Margin="5" VerticalAlignment="Center"/>
      <Menu Foreground="#ccc">
          <!--File / Edit Menu-->
        <MenuItem Header="File" Foreground="#ccc">
            <MenuItem Header="Open" Command="{Binding OpenProjectCommand}" Foreground="#ccc"/>

            <!-- Recent Projects Submenu -->
            <MenuItem Header="Recent Projects" Foreground="#ccc" IsEnabled="{Binding HasRecentProjects}"
                      ItemsSource="{Binding RecentProjectMenuItems}">
                <MenuItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="Recent Projects"/>
                    </DataTemplate>
                </MenuItem.HeaderTemplate>
            </MenuItem>
            <Separator/>

            <MenuItem Header="Save" Command="{Binding SaveProjectCommand}" Foreground="#ccc"/>
            <MenuItem Header="Save As" Command="{Binding SaveProjectAsCommand}" Foreground="#ccc"/>
            <Separator/>
            <MenuItem Header="Exit" Command="{Binding ExitCommand}" Foreground="#ccc"/>
        </MenuItem>
        <MenuItem Header="Edit" Foreground="#ccc">
            <MenuItem Header="Undo" Command="{Binding UndoCommand}" Foreground="#ccc"/>
            <MenuItem Header="Redo" Command="{Binding RedoCommand}" Foreground="#ccc"/>
        </MenuItem>
          <!--Add Entity Menu-->
        <MenuItem Header="Add" Foreground="#ccc">
            <MenuItem Header="Empty Entity" Command="{Binding CreateEntityCommand}" CommandParameter="empty"/>
            <MenuItem Header="Empty Transform" Command="{Binding CreateEntityCommand}" CommandParameter="emptyTransform"/>
            <Separator/>
            <MenuItem Header="Camera" Command="{Binding CreateEntityCommand}" CommandParameter="camera"/>
            <MenuItem Header="Environment" Command="{Binding CreateEntityCommand}" CommandParameter="environment"/>
            <Separator/>
            <MenuItem Header="Directional Light" Command="{Binding CreateEntityCommand}" CommandParameter="directionalLight"/>
            <MenuItem Header="Point Light" Command="{Binding CreateEntityCommand}" CommandParameter="pointLight"/>
            <Separator/>
            <MenuItem Header="Sphere" Command="{Binding CreateEntityCommand}" CommandParameter="sphere"/>
            <MenuItem Header="Box" Command="{Binding CreateEntityCommand}" CommandParameter="box"/>
            <MenuItem Header="Rounded Box" Command="{Binding CreateEntityCommand}" CommandParameter="roundedBox"/>
            <MenuItem Header="Donut" Command="{Binding CreateEntityCommand}" CommandParameter="torus"/>
            <MenuItem Header="Pyramid" Command="{Binding CreateEntityCommand}" CommandParameter="pyramid"/>
            <MenuItem Header="Plane" Command="{Binding CreateEntityCommand}" CommandParameter="plane"/>
            <MenuItem Header="Cylinder" Command="{Binding CreateEntityCommand}" CommandParameter="cylinder"/>
            <MenuItem Header="Capsule" Command="{Binding CreateEntityCommand}" CommandParameter="capsule"/>
            <MenuItem Header="Cone" Command="{Binding CreateEntityCommand}" CommandParameter="cone"/>
            <Separator/>
            <MenuItem Header="Terrain" Command="{Binding CreateEntityCommand}" CommandParameter="terrain"/>
        </MenuItem>
          <!--Other Menus-->
        <MenuItem Header="Help" Foreground="#ccc">
            <MenuItem Header="About" Command="{Binding AboutCommand}" Foreground="#ccc"/>
            <MenuItem Header="Roadmap" Command="{Binding RoadmapCommand}" Foreground="#ccc"/>
            <MenuItem Header="Forum" Command="{Binding ForumCommand}" Foreground="#ccc"/>
        </MenuItem>
      </Menu>
    </StackPanel>

   <!--Bottom Utility Bar-->
    <Grid DockPanel.Dock="Bottom" Background="#444" Height="24">
        <!--Recent Controls Block-->
        <TextBlock x:Name="RecentControlsText" Text="{Binding RecentControlsText}" FontSize="12" Foreground="#BBB"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18, 0, 0, 0"/>

        <!--Progress Bar And Text-->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Width="200">
            <Border x:Name="ProgressBarContainer" Background="Transparent" CornerRadius="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ProgressBar x:Name="UniversalProgressBar" Height="18" Background="#111" Margin="0,0,8,0"
                             Foreground="#FF6A00" Cursor="Hand" IsHitTestVisible="True"/>
            </Border>
        
            <!--Text Overlays-->
            <TextBlock x:Name="ProgressPercentageText" Text="0%" FontSize="10" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       IsVisible="{Binding #UniversalProgressBar.IsVisible}"/>
            <TextBlock x:Name="TaskCountText" Text="0" FontSize="10" Foreground="White"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"
                       IsVisible="{Binding #UniversalProgressBar.IsVisible}"/>
        </Grid>
    </Grid>

    <!--Basic Grid Layout-->
    <Grid ColumnDefinitions="*, 2, 300">
      <Grid Grid.Column="0" RowDefinitions="*, 2, 250">
        <Grid Grid.Row="0" ColumnDefinitions="200, 2, *">
          <!--Left Tabs-->
          <Grid Grid.Column="0">
            <TabControl x:Name="leftTabs" ItemsSource="{Binding LeftTabs}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        SelectedItem="{Binding SelectedLeftTab, Mode=TwoWay}">
              <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="{Binding Icon}" Foreground="#888" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
              </TabControl.ItemTemplate>
            </TabControl>
            <Button x:Name="LeftAddButton" Content="+" FontSize="14" Width="18" Height="18"
                    Margin="6,6,6,6" Padding="3,-2,0,0" HorizontalAlignment="Right" VerticalAlignment="Top">
              <!--Button.Flyout>
                <Flyout Placement="Bottom" ShowMode="TransientWithDismissOnPointerMoveAway">
                  <StackPanel>
                    <Button Content="World" Command="{Binding AddWindowToTabCommand}" CommandParameter="World,left" HorizontalAlignment="Stretch"/>
                    <Button Content="Environment" Command="{Binding AddWindowToTabCommand}" CommandParameter="Environment,left" HorizontalAlignment="Stretch"/>
                    <Button Content="Assets" Command="{Binding AddWindowToTabCommand}" CommandParameter="Assets,left" HorizontalAlignment="Stretch"/>
                    <Button Content="Console" Command="{Binding AddWindowToTabCommand}" CommandParameter="Console,left" HorizontalAlignment="Stretch"/>
                    <Button Content="Properties" Command="{Binding AddWindowToTabCommand}" CommandParameter="Properties,left" HorizontalAlignment="Stretch"/>
                    <Button Content="Settings" Command="{Binding AddWindowToTabCommand}" CommandParameter="Settings,left" HorizontalAlignment="Stretch"/>
                    <Button Content="Developer" Command="{Binding AddWindowToTabCommand}" CommandParameter="Developer,left" HorizontalAlignment="Stretch"/>
                  </StackPanel>
                </Flyout>
              </Button.Flyout-->
            </Button>
          </Grid>
          <GridSplitter Grid.Column="1" ResizeDirection="Auto"/>

          <!--Center Tabs-->
          <Grid Grid.Column="2">
            <TabControl x:Name="centerTabs" ItemsSource="{Binding CenterTabs}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        SelectedItem="{Binding SelectedCenterTab, Mode=TwoWay}">
              <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="{Binding Icon}" Foreground="#888" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
              </TabControl.ItemTemplate>
            </TabControl>

            <Button x:Name="CenterAddButton" Content="+" FontSize="14" Width="18" Height="18"
                    Margin="6,6,6,6" Padding="3,-2,0,0" HorizontalAlignment="Right" VerticalAlignment="Top">
              <!--Button.Flyout>
                <Flyout Placement="Bottom" ShowMode="TransientWithDismissOnPointerMoveAway">
                  <StackPanel>
                    <Button Content="World" Command="{Binding AddWindowToTabCommand}" CommandParameter="World,center" HorizontalAlignment="Stretch"/>
                    <Button Content="Environment" Command="{Binding AddWindowToTabCommand}" CommandParameter="Environment,center" HorizontalAlignment="Stretch"/>
                    <Button Content="Assets" Command="{Binding AddWindowToTabCommand}" CommandParameter="Assets,center" HorizontalAlignment="Stretch"/>
                    <Button Content="Console" Command="{Binding AddWindowToTabCommand}" CommandParameter="Console,center" HorizontalAlignment="Stretch"/>
                    <Button Content="Properties" Command="{Binding AddWindowToTabCommand}" CommandParameter="Properties,center" HorizontalAlignment="Stretch"/>
                    <Button Content="Settings" Command="{Binding AddWindowToTabCommand}" CommandParameter="Settings,center" HorizontalAlignment="Stretch"/>
                    <Button Content="Developer" Command="{Binding AddWindowToTabCommand}" CommandParameter="Developer,center" HorizontalAlignment="Stretch"/>
                  </StackPanel>
                </Flyout>
              </Button.Flyout-->
            </Button>
          </Grid>
        </Grid>
        
        <GridSplitter Grid.Row="1" ResizeDirection="Auto"/>
        
        <!--Bottom Tabs-->
        <Grid Grid.Row="2">
          <TabControl x:Name="bottomTabs" ItemsSource="{Binding BottomTabs}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      SelectedItem="{Binding SelectedBottomTab, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="{Binding Icon}" Foreground="#888" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
          </TabControl>

          <Button x:Name="BottomAddButton" Content="+" FontSize="14" Width="18" Height="18"
                    Margin="6,6,6,6" Padding="3,-2,0,0" HorizontalAlignment="Right" VerticalAlignment="Top">
            <!--Button.Flyout>
              <Flyout Placement="Bottom" ShowMode="TransientWithDismissOnPointerMoveAway">
                <StackPanel>
                  <Button Content="World" Command="{Binding AddWindowToTabCommand}" CommandParameter="World,bottom" HorizontalAlignment="Stretch"/>
                  <Button Content="Environment" Command="{Binding AddWindowToTabCommand}" CommandParameter="Environment,bottom" HorizontalAlignment="Stretch"/>
                  <Button Content="Assets" Command="{Binding AddWindowToTabCommand}" CommandParameter="Assets,bottom" HorizontalAlignment="Stretch"/>
                  <Button Content="Console" Command="{Binding AddWindowToTabCommand}" CommandParameter="Console,bottom" HorizontalAlignment="Stretch"/>
                  <Button Content="Properties" Command="{Binding AddWindowToTabCommand}" CommandParameter="Properties,bottom" HorizontalAlignment="Stretch"/>
                  <Button Content="Settings" Command="{Binding AddWindowToTabCommand}" CommandParameter="Settings,bottom" HorizontalAlignment="Stretch"/>
                  <Button Content="Developer" Command="{Binding AddWindowToTabCommand}" CommandParameter="Developer,bottom" HorizontalAlignment="Stretch"/>
                </StackPanel>
              </Flyout>
            </Button.Flyout-->
          </Button>
        </Grid>
      </Grid>

      <GridSplitter Grid.Column="1" ResizeDirection="Auto"/>

      <!--Right Tabs-->
      <Grid Grid.Column="2">
        <TabControl x:Name="rightTabs" ItemsSource="{Binding RightTabs}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    SelectedItem="{Binding SelectedRightTab, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="{Binding Icon}" Foreground="#888" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>

        <Button x:Name="RightAddButton" Content="+" FontSize="14" Width="18" Height="18"
                    Margin="6,6,6,6" Padding="3,-2,0,0" HorizontalAlignment="Right" VerticalAlignment="Top">
          <!--Button.Flyout>
            <Flyout Placement="Bottom" ShowMode="TransientWithDismissOnPointerMoveAway">
              <StackPanel>
                <Button Content="World" Command="{Binding AddWindowToTabCommand}" CommandParameter="World,right" HorizontalAlignment="Stretch"/>
                <Button Content="Environment" Command="{Binding AddWindowToTabCommand}" CommandParameter="Environment,right" HorizontalAlignment="Stretch"/>
                <Button Content="Assets" Command="{Binding AddWindowToTabCommand}" CommandParameter="Assets,right" HorizontalAlignment="Stretch"/>
                <Button Content="Console" Command="{Binding AddWindowToTabCommand}" CommandParameter="Console,right" HorizontalAlignment="Stretch"/>
                <Button Content="Properties" Command="{Binding AddWindowToTabCommand}" CommandParameter="Properties,right" HorizontalAlignment="Stretch"/>
                <Button Content="Settings" Command="{Binding AddWindowToTabCommand}" CommandParameter="Settings,right" HorizontalAlignment="Stretch"/>
                <Button Content="Developer" Command="{Binding AddWindowToTabCommand}" CommandParameter="Developer,right" HorizontalAlignment="Stretch"/>
              </StackPanel>
            </Flyout>
          </Button.Flyout-->
        </Button>
      </Grid>
    </Grid>
  </DockPanel>
</Window>